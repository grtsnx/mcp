NODE_ENV=development
PORT=3000
PLATFORM_NAME=MCP Agents

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true

# Shared secret for MCP clients (Authorization: Bearer). At least 16 characters;
# production requires at least 32 characters. Generate a random secret.
MCP_API_KEY=replace-with-a-long-random-key
# Where MCP clients sign a person in, such as ms-backend. Comma-separated URLs. Optional.
MCP_AUTHORIZATION_SERVERS=

# Base URL of ms-backend (HTTP is allowed only outside production).
BACKEND_BASE_URL=http://localhost:8080

# In-memory sign-in sessions (lost on restart, one server instance only).
# Most sessions kept at once; the least recently used one is dropped when full.
SESSION_MAX_COUNT=1000
# A session unused for this long is dropped.
SESSION_IDLE_TTL_SECONDS=3600
# How long a refresh token stays valid in ms-backend (7 days); the session is dropped after it.
SESSION_REFRESH_TTL_SECONDS=604800

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=
